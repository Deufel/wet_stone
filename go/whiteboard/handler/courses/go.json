     {"do": "notes", "n": 7},
     {"do": "ring", "at": [220, 800], "r": 190, "ry": 70},
     {"do": "check", "item": "Always assign"}
    ]
   }
  ]},
  {"title": "Sharing", "pages": [
   {
    "title": "copy: a slice of your own",
    "pace": 1.6,
    "notes": {"lang": "go", "lines": [
     "// Sharing, and how to stop",
     "a := []int{1, 2, 3, 4}",
     "b := a[:2]   // shares a's array",
     "b[0] = 9     // so a[0] is 9 too",
     "",
     "c := make([]int, len(b))",
     "copy(c, b)   // c has an array of its own",
     "c[1] = 5     // a and b never see it"
    ]},
    "checklist": [
     "A re-slice shares the array",
     "A write through one shows in the other",
     "make + copy gives an array of your own"
    ],
    "steps": [
     {"do": "notes", "n": 2},
     {"do": "box", "at": [100, 150, 240, 230], "label": "1"},
     {"do": "box", "at": [260, 150, 400, 230], "label": "2"},
