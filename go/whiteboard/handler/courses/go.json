{
 "title": "Learning Go",
 "chapters": [
  {"title": "Slices", "pages": [
   {"use": "go", "title": "A slice is a header"},
   {
    "title": "When append runs out of room",
    "pace": 1.6,
    "notes": {"lang": "go", "lines": [
     "// When append runs out of room",
     "s := make([]int, 3, 4) // len 3, cap 4: one spare slot",
     "s = append(s, 7)       // fits: it writes the spare slot",
     "t := append(s, 8)      // full: a new array (cap 8), copied, then 8",
     "t[0] = 100             // only t's array changes: s[0] is still 0",
     "s = t                  // nothing points at the old array: garbage",
     "// so always keep the result: s = append(s, x)"
    ]},
    "checklist": [
     "make sets len and cap",
     "append fills spare capacity first",
     "Past cap, append allocates and copies",
     "The old slice keeps the old array",
     "Always assign append's result"
    ],
    "steps": [
     {"do": "notes", "n": 2},
     {"do": "box", "at": [100, 120, 240, 200], "label": "0"},
     {"do": "box", "at": [260, 120, 400, 200], "label": "0"},
     {"do": "box", "at": [420, 120, 560, 200], "label": "0"},
     {"do": "box", "at": [580, 120, 720, 200], "label": "_"},
     {"do": "box", "at": [100, 290, 420, 370], "label": "s · len 3 · cap 4"},
     {"do": "arrow", "from": [170, 290], "to": [170, 200]},
     {"do": "check", "item": "make sets"},
     {"do": "ring", "at": [650, 160], "r": 100, "ry": 70, "sem": "wrn"},
     {"do": "notes", "n": 3},
     {"do": "click", "at": [592, 132]},
     {"do": "label", "text": "7"},
     {"do": "click", "at": [112, 302]},
     {"do": "label", "text": "s · len 4 · cap 4"},
     {"do": "check", "item": "append fills"},
     {"do": "laser", "at": [410, 160], "r": 340},
     {"do": "ask", "question": "s is full: len 4, cap 4. Where does t := append(s, 8) put the 8?",
      "options": ["in s's array", "in a new array"], "answer": "in a new array",
      "explain": "No room left: append makes a bigger array, copies, then appends."},
     {"do": "notes", "n": 4},
     {"do": "box", "at": [40, 560, 120, 640], "label": "0"},
     {"do": "box", "at": [160, 560, 240, 640], "label": "0"},
