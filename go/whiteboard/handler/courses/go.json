     {"do": "box", "at": [760, 560, 840, 640], "label": "_"},
     {"do": "box", "at": [880, 560, 960, 640], "label": "_"},
     {"do": "underline", "from": [40, 660], "to": [480, 660], "sem": "inf"},
     {"do": "box", "at": [60, 760, 380, 840], "label": "t · len 5 · cap 8"},
     {"do": "arrow", "from": [80, 760], "to": [80, 640]},
     {"do": "check", "item": "Past cap"},
     {"do": "notes", "n": 5},
     {"do": "click", "at": [52, 572]},
     {"do": "label", "text": "100"},
     {"do": "style", "sem": "dgr", "fg": 0.8},
     {"do": "laser", "at": [170, 160], "r": 80},
     {"do": "ask", "question": "After t[0] = 100, what is s[0]?",
      "options": ["0", "100"], "answer": "0",
      "explain": "s still points at the old array; only t moved."},
     {"do": "check", "item": "The old slice"},
     {"do": "notes", "n": 6},
     {"do": "erase", "at": [170, 250]},
     {"do": "erase", "at": [112, 302]},
     {"do": "drag", "from": [80, 100], "to": [760, 220]},
     {"do": "delete"},
