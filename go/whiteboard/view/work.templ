package view

import (
	"strings"
	"strconv"
	"whiteboard/db"
)

// ─── The checklist ──────────────────────────────────────────────────────────

// TodoCard is the board's checklist, shared by everyone on it. No history:
// each item keeps only when it was done and by whom (SQLite stamps it).
templ TodoCard(name string) {
	<section class="card todo-card" aria-label="Checklist">
		<header class="card-head">
			@Icon("list")
			<h2>Checklist</h2>
			@Saved("todo")
		</header>
		@Todos(name, TodoCardID, nil)
		<div class="row oneline todo-add">
			<input type="text" placeholder="Add an item" maxlength="200" aria-label="New checklist item" data-bind:_todo data-on:keydown={ "if (evt.key === 'Enter') { " + todoAdd(name) + " }" }/>
			<button class="icon" data-on:click={ todoAdd(name) } aria-label="Add" title="Add">
				@Icon("plus")
			</button>
		</div>
	</section>
}

// TodoDrawer is the same checklist again, explicitly: on a phone the card has
// no room in the workspace, and it opens from the top (a phone's keyboard
// rises from the bottom, and would cover a bottom drawer's input). Its list has its own id; the stream sends both.
templ TodoDrawer(name string) {
	<aside id="todo-drawer" class="drawer top todo-drawer" popover aria-label="Checklist">
		<header class="drawer-head">
			<h2>Checklist</h2>
			@Saved("todo")
			<button class="icon" popovertarget="todo-drawer" popovertargetaction="hide" aria-label="Close checklist">
				@Icon("x")
			</button>
		</header>
		@Todos(name, TodoDrawerID, nil)
		<div class="row oneline todo-add">
			<input type="text" placeholder="Add an item" maxlength="200" aria-label="New checklist item" data-bind:_todo data-on:keydown={ "if (evt.key === 'Enter') { " + todoAdd(name) + " }" }/>
			<button class="icon" data-on:click={ todoAdd(name) } aria-label="Add" title="Add">
				@Icon("plus")
			</button>
		</div>
	</aside>
}

// The two lists' ids: the card's and the drawer's.
const (
	TodoCardID   = "todo"
	TodoDrawerID = "todo-m"
)

// TodoLists renders both lists for one stream patch.
templ TodoLists(name string, list []db.Todo) {
	@Todos(name, TodoCardID, list)
	@Todos(name, TodoDrawerID, list)
}

// Todos is the list: a morph target on the board's stream, sent when it changes.
templ Todos(name, id string, list []db.Todo) {
	<div id={ id } class="todo">
		if len(list) > 0 {
			<p class="todo-sum num">{ todoSum(list) }</p>
		}
		<ul class="todo-list">
			for _, t := range list {
				<li id={ id + "-" + strconv.FormatInt(t.ID, 10) } data-ui-done?={ t.Done }>
					<button class="check" data-on:click={ postKept(name, "todo/"+strconv.FormatInt(t.ID, 10)+"/toggle") } aria-pressed={ strconv.FormatBool(t.Done) } aria-label={ "Done: " + t.Text }>
						if t.Done {
							@Icon("checked")
						} else {
							@Icon("square")
						}
					</button>
					<span class="text">{ t.Text }</span>
					if t.Done {
						<time class="when num" datetime={ t.DoneISO }>{ doneLine(t) }</time>
					}
					@todoTime(name, t)
					<button class="icon del" data-on:click={ postKept(name, "todo/"+strconv.FormatInt(t.ID, 10)+"/delete") } aria-label={ "Delete " + t.Text } title="Delete">
						@Icon("x")
					</button>
				</li>
			}
		</ul>
		if len(list) == 0 {
			<p class="hint">Nothing on the list yet.</p>
		}
	</div>
}

// todoTime is an item's time: its clock (start, stop), what it has taken
// (counting on while the clock runs), its budget, and a meter against it.
templ todoTime(name string, t db.Todo) {
	<span class="todo-time" data-ui-running?={ t.Running() } data-ui-over?={ t.BudgetS > 0 && t.Elapsed() > t.BudgetS*1000 }>
		if !t.Done {
			<button class="icon clock" data-on:click={ postKept(name, "todo/"+strconv.FormatInt(t.ID, 10)+"/track") } aria-pressed={ strconv.FormatBool(t.Running()) } aria-label={ clockLabel(t) } title={ clockLabel(t) }>
				if t.Running() {
					@templ.Raw(clockRunning)
				} else {
					@Icon("clock")
				}
			</button>
		}
		if t.Elapsed() > 0 || t.Running() {
			<span class="spent num" data-ms={ strconv.FormatInt(t.Elapsed(), 10) } if t.Running() { data-on-interval__duration.1s={ tickJS } }>{ Duration(t.Elapsed()) }</span>
		}
		if t.BudgetS > 0 {
			<meter min="0" max={ strconv.FormatInt(t.BudgetS, 10) } value={ strconv.FormatInt(t.Elapsed()/1000, 10) } high={ strconv.FormatInt(t.BudgetS*9/10, 10) } optimum="0" title={ Duration(t.Elapsed()) + " of " + budgetWord(t.BudgetS) }></meter>
		}
		if !t.Done {
			<button class="icon budget" data-on:click={ "$_budgetFor = " + strconv.FormatInt(t.ID, 10) + "; document.getElementById('budget-menu').showPopover({source: el})" } aria-label={ budgetLabel(t) } title={ budgetLabel(t) }>
				@templ.Raw(budgetIcon)
			</button>
		}
	</span>
}

func clockLabel(t db.Todo) string {
	if t.Running() {
		return "Stop the clock on " + t.Text
	}
	return "Start the clock on " + t.Text
}

func budgetLabel(t db.Todo) string {
	if t.BudgetS > 0 {
		return "Budget: " + budgetWord(t.BudgetS)
	}
	return "Give it a time budget"
}

// budgetWord is a budget, short: 15m, 1hr 30m, 2d (no zero parts).
func budgetWord(s int64) string {
	parts := []string{}
	for _, u := range []struct {
		n int64
		w string
	}{{86400, "d"}, {3600, "hr"}, {60, "m"}, {1, "s"}} {
		if s >= u.n {
			parts = append(parts, strconv.FormatInt(s/u.n, 10)+u.w)
			s %= u.n
		}
	}
	return strings.Join(parts, " ")
}

// Duration reads a time as the checklist shows it: 42s, 3m 5s, 2hr 10m,
// 1d 4hr.
func Duration(ms int64) string {
	s := ms / 1000
	d, h, m, x := s/86400, s%86400/3600, s%3600/60, s%60
	switch {
	case d > 0:
		return strconv.FormatInt(d, 10) + "d " + strconv.FormatInt(h, 10) + "hr"
	case h > 0:
		return strconv.FormatInt(h, 10) + "hr " + strconv.FormatInt(m, 10) + "m"
	case m > 0:
		return strconv.FormatInt(m, 10) + "m " + strconv.FormatInt(x, 10) + "s"
	}
	return strconv.FormatInt(x, 10) + "s"
}

// tickJS counts a running clock on, each second, from what the server last
// said (data-ms): the same format as Duration, and its meter with it.
const tickJS = "if (el._ms !== el.dataset.ms) { el._ms = el.dataset.ms; el._t0 = Date.now() } " +
	"const ms = +el.dataset.ms + Date.now() - el._t0, s = Math.floor(ms / 1000), d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; " +
	"el.textContent = d ? d + 'd ' + h + 'hr' : h ? h + 'hr ' + m + 'm' : m ? m + 'm ' + x + 's' : x + 's'; " +
	"const mt = el.parentElement.querySelector('meter'); if (mt) { mt.value = s; el.parentElement.toggleAttribute('data-ui-over', s > +mt.max) }"

// BudgetMenu sets the budget of the item $_budgetFor names; one for the
// page, opened at the item's button.
templ BudgetMenu(name string) {
	<div id="budget-menu" class="menu budget-menu" popover data-signals__ifmissing="{_budgetFor: 0, _budgetMin: ''}">
		<p class="meta">Time budget</p>
		<div class="budget-picks">
			for _, b := range budgets {
				<button data-on:click={ budgetPost(name, strconv.Itoa(b.s)) }>{ b.label }</button>
			}
		</div>
		<div class="row oneline">
			<input type="number" min="1" max="10000" placeholder="minutes" aria-label="Budget in minutes" data-bind:_budget-min data-on:keydown={ "evt.stopPropagation(); if (evt.key === 'Enter' && +$_budgetMin > 0) { " + budgetPost(name, "Math.round(+$_budgetMin * 60)") + " }" }/>
			<button data-on:click={ "+$_budgetMin > 0 && " + budgetPost(name, "Math.round(+$_budgetMin * 60)") }>Set</button>
			<button class="sec" data-on:click={ budgetPost(name, "0") }>Clear</button>
		</div>
	</div>
}

var budgets = []struct {
	label string
	s     int
}{{"15m", 900}, {"30m", 1800}, {"1hr", 3600}, {"2hr", 7200}, {"4hr", 14400}, {"1d", 86400}}

func budgetPost(name, seconds string) string {
	return "@post('/b/" + name + "/todo/' + $_budgetFor + '/budget', {payload: {n: " + seconds + ", inst: $inst}, requestCancellation: 'disabled'}); document.getElementById('budget-menu').hidePopover()"
}

func todoAdd(name string) string {
	return "const t = $_todo.trim(); if (t) { $_todo = ''; @post('/b/" + name + "/todo/add', {payload: {text: t, inst: $inst}, requestCancellation: 'disabled'}) }"
}

func todoSum(list []db.Todo) string {
	done := 0
	for _, t := range list {
		if t.Done {
			done++
		}
	}
	return strconv.Itoa(done) + " of " + strconv.Itoa(len(list)) + " done"
}

func doneLine(t db.Todo) string {
	if t.DoneBy == "" {
		return t.DoneAt
	}
	return t.DoneAt + " · " + t.DoneBy
}

// ─── Notes ──────────────────────────────────────────────────────────────────

// noteLangs are the highlighter's languages (static/highlight.js).
var noteLangs = []string{"css", "html", "python", "javascript", "go", "sqlite", "odin", "mojo"}

// NoteLang reports whether l is a language the notes can be highlighted as.
func NoteLang(l string) bool {
	for _, x := range noteLangs {
		if x == l {
			return true
		}
	}
	return l == ""
}

// NotesCard is your private notebook on this board: monospace, highlighted as
// the language you pick, saved as you type, and the same on all your devices.
// The text arrives as a signal ($_notes), never a morph, so another device's
// save never lands under your caret: the editor takes it only when it is not
// the one being typed in.
templ NotesCard(name string) {
	<section class="card notes-card" aria-label="Notes">
		<header class="card-head">
			@Icon("notebook")
			<h2>Notes</h2>
			<span class="meta">only you</span>
			@Saved("notes")
			<select id="notes-lang" class="lang" aria-label="Highlight as" data-effect="el.value = $_notes.lang" data-on:change={ notesSave(name) }>
				<option value="">plain</option>
				for _, l := range noteLangs {
					<option value={ l }>{ l }</option>
				}
			</select>
		</header>
		<pre class="notes-pre"><code
	id="notes"
	contenteditable="plaintext-only"
	spellcheck="false"
	data-placeholder="Your notes on this board. Only you see them."
	data-attr:class="$_notes.lang"
	data-effect={ notesApply }
	data-on:keydown={ notesKeys }
	data-on:input="el.normalize(); window.highlightAll && window.highlightAll()"
	data-on:input__debounce.600ms={ notesSave(name) }
></code></pre>
	</section>
}

func notesSave(name string) string {
	return "@post('/b/" + name + "/notes', {payload: {text: document.getElementById('notes').textContent, lang: document.getElementById('notes-lang').value, inst: $inst}, requestCancellation: 'disabled'})"
}

// notesApply takes the server's notes into the editor unless it is being typed in.
const notesApply = "const t = $_notes.text, l = $_notes.lang; " +
	"if (document.activeElement !== el && el.textContent !== t) { el.textContent = t } " +
	"requestAnimationFrame(() => window.highlightAll && window.highlightAll())"

// Tab indents (a notebook for code); the board's shortcuts never see these keys.
const notesKeys = "evt.stopPropagation(); if (evt.key === 'Tab') { evt.preventDefault(); document.execCommand('insertText', false, '\\t') }"

