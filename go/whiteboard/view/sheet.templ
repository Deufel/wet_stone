package view

import (
	"strconv"
	"whiteboard/board"
	"whiteboard/db"
)

// A book's pages: sheets sent from its whiteboard. A sheet is a letter page,
// as it prints: the book's title and the chapter at its head, the drawing
// (cropped to what was sent, scaled to fit), and the author, the date and
// the page number at its foot. Ink on paper, on screen too.

// sheetPaper is one page. Its type is in container units, so it reads the
// same at any size, a thumbnail to the printed sheet.
templ sheetPaper(b *db.Book, s db.Sheet, marks string) {
	<article class="leaf" aria-label={ "Page " + strconv.Itoa(s.No) }>
		<div class="leaf-in">
		<header class="leaf-head">
			<strong>{ b.Title }</strong>
			<span>{ chapterLine(s) }</span>
		</header>
		<div class="leaf-body">
			@templ.Raw(board.Drawing(s.Drawing, s.Box, "print-board leaf-drawing", marks))
		</div>
		<footer class="leaf-foot">
			<span>{ b.Author }</span>
			<span>{ s.Made }</span>
			<span>{ "p. " + strconv.Itoa(s.No) }</span>
		</footer>
		</div>
	</article>
}

// PageStrip is the whiteboard's footer, the book's pages, small; and the
// teacher's save in the teaching bar. For the teacher a page is the way to
// put it back on the whiteboard (its save then replaces it); for anyone else
// the way to read it. A morph target pair on the board's stream.
templ PageStrip(name string, b *db.Book, sheets []db.Sheet, owner bool, editing int) {
	<div id="page-strip" class="page-strip">
		if b != nil {
			<ol class="strip-pages" data-signals__ifmissing="{_pdrag: 0, _pover: 0}">
				for i, s := range sheets {
					if i == 0 || sheets[i-1].ChapterNo != s.ChapterNo {
						<li class="strip-chapter" title={ chapterLine(s) }>{ "Ch " + strconv.Itoa(s.ChapterNo) }</li>
					}
					if owner {
						<li
							class="strip-item"
							data-ui-editing?={ s.No == editing }
							draggable="true"
							data-on:dragstart={ "$_pdrag = " + id64(s.ID) + "; evt.dataTransfer.effectAllowed = 'move'; evt.dataTransfer.setData('text/plain', '" + id64(s.ID) + "')" }
							data-on:dragover="$_pdrag && evt.preventDefault()"
							data-on:dragenter={ "$_pover = " + id64(s.ID) }
							data-on:dragend="$_pdrag = 0; $_pover = 0"
							data-on:drop={ "evt.preventDefault(); if ($_pdrag && $_pdrag != " + id64(s.ID) + ") { @post('/b/" + name + "/sheet/' + $_pdrag + '/move/" + id64(s.ID) + "', {requestCancellation: 'disabled'}) }; $_pdrag = 0; $_pover = 0" }
							data-class:drop-over={ "$_pdrag && $_pdrag != " + id64(s.ID) + " && $_pover == " + id64(s.ID) }
							data-class:dragging={ "$_pdrag == " + id64(s.ID) }
						>
							<button class="strip-page" draggable="false" data-on:click={ "@post('/b/" + name + "/editpage/" + strconv.Itoa(s.No) + "', {payload: {inst: $inst}})" } title={ "Page " + strconv.Itoa(s.No) + ": put it back on the whiteboard to change it (drag to move it)" }>
								@stripPage(s)
							</button>
							<span class="strip-acts">
								<button class="icon" data-on:click={ "@post('/b/" + name + "/sheet/" + id64(s.ID) + "/copy', {requestCancellation: 'disabled'})" } aria-label={ "Copy page " + strconv.Itoa(s.No) } title="A copy, after it">
									@Icon("copy")
								</button>
								<button class="icon dgr" data-on:click={ "$_delpage = " + strconv.Itoa(s.No) + "; $_delsheet = " + id64(s.ID) + "; document.getElementById('delete-page-confirm').showModal()" } aria-label={ "Delete page " + strconv.Itoa(s.No) } title="Delete it">
									@Icon("trash")
								</button>
							</span>
						</li>
					} else {
						<li>
							<a class="strip-page" href={ templ.SafeURL("/book/" + b.Name + "/page/" + strconv.Itoa(s.No)) } title={ "Page " + strconv.Itoa(s.No) }>
								@stripPage(s)
							</a>
						</li>
					}
				}
				if owner {
					<li class="strip-add">
						<button class="sec" data-on:click={ "@post('/book/" + b.Name + "/chapter')" } title="A new chapter: the next pages sent go in it">
							@Icon("plus")
							Chapter
						</button>
					</li>
				}
			</ol>
		}
	</div>
	<div id="page-save" class="button-group tools page-save">
		if owner && editing > 0 {
			<button class="tool stack pri suc" data-on:click={ postKept(name, "sendpage") } aria-label={ "Save page " + strconv.Itoa(editing) } title={ "Save the whiteboard as page " + strconv.Itoa(editing) + " again" }>
				@Icon("page-in")
				<span class="badge">{ strconv.Itoa(editing) }</span>
			</button>
			<button class="tool stack sec" data-on:click={ postKept(name, "newpage") } aria-label="New page" title={ "Leave page " + strconv.Itoa(editing) + " as it was and start a clean page" }>
				@Icon("plus")
			</button>
			<button class="tool stack sec dgr" data-on:click={ "$_delpage = " + strconv.Itoa(editing) + "; $_delsheet = " + id64(editingID(sheets, editing)) + "; document.getElementById('delete-page-confirm').showModal()" } aria-label={ "Delete page " + strconv.Itoa(editing) } title={ "Delete page " + strconv.Itoa(editing) + " from the book" }>
				@Icon("trash")
			</button>
		} else if owner {
			<button class="tool stack pri" data-on:click={ postKept(name, "sendpage") } aria-label="Send to page" title="Send the whole whiteboard to the book's next page, and turn to a clean one">
				@Icon("page-in")
			</button>
		}
	</div>
}

templ stripPage(s db.Sheet) {
	<span class="mini">
		@templ.Raw(sheetDrawing(s))
		if s.Lesson != "" {
			<span class="has-lesson" title="A lesson: presented on the whiteboard">
				@Icon("play")
			</span>
		}
		<span class="no">{ strconv.Itoa(s.No) }</span>
	</span>
}

// Marks is a student's own layer over the whiteboard: their marks, and the
// one being drawn. A morph target on their stream only.
templ Marks(marks [][]int32, height int32) {
	<svg id="marks" class="marks" xmlns="http://www.w3.org/2000/svg" viewBox={ "0 0 1000 " + strconv.Itoa(int(height)) }>
		for _, m := range marks {
			if len(m) >= 4 {
				<path class="mark" d={ board.PenPath(m) }></path>
			}
		}
	</svg>
}

// SheetView is a page on its own: the page, the way to the pages beside it,
// and printing it (only the page prints, letter, edge to edge).
templ SheetView(u *db.User, b *db.Book, sheets []db.Sheet, no int, marks string) {
	@Doc(b.Title+" · p. "+strconv.Itoa(no)+" · draw", nil) {
		<div class="page leaf-page">
			<header class="pg-header app-header leaf-bar">
				<a class="button-like" href={ templ.SafeURL(sheetBack(b)) }>
					@Icon("back")
					{ sheetBackLabel(b) }
				</a>
				<span class="meta">{ "Page " + strconv.Itoa(no) + " of " + strconv.Itoa(len(sheets)) }</span>
				<div class="row end">
					if no > 1 {
						<a class="icon-link" href={ templ.SafeURL("/book/" + b.Name + "/page/" + strconv.Itoa(no-1)) } aria-label="Previous page" title="Previous page">←</a>
					}
					if no < len(sheets) {
						<a class="icon-link" href={ templ.SafeURL("/book/" + b.Name + "/page/" + strconv.Itoa(no+1)) } aria-label="Next page" title="Next page">→</a>
					}
					<button data-on:click="window.print()">
						@Icon("printer")
						Print
					</button>
					if u != nil && u.ID == b.OwnerID {
						<button class="icon dgr sec" data-on:click={ "@post('/book/" + b.Name + "/sheet/" + strconv.FormatInt(sheets[no-1].ID, 10) + "/remove'); setTimeout(() => location.assign('" + sheetBack(b) + "'), 400)" } aria-label="Take this page out" title="Take this page out of the book">
							@Icon("trash")
						</button>
					}
				</div>
			</header>
			<main class="pg-main scroll-y leaf-main">
				@sheetPaper(b, sheets[no-1], marks)
			</main>
		</div>
		<script src="/static/highlight.js"></script>
		@mathAssets()
	}
}

// chapterLine names the chapter, its title too unless it is just "Chapter n".
func chapterLine(s db.Sheet) string {
	n := "Chapter " + strconv.Itoa(s.ChapterNo)
	if s.ChapterTitle == "" || s.ChapterTitle == n {
		return n
	}
	return n + " · " + s.ChapterTitle
}

func sheetBack(b *db.Book) string {
	if b.Board != "" {
		return "/b/" + b.Board
	}
	return "/book/" + b.Name
}

func sheetBackLabel(b *db.Book) string {
	if b.Board != "" {
		return "The whiteboard"
	}
	return "The book"
}

// sheetDrawing is a page's drawing, for a small copy of it.
func sheetDrawing(s db.Sheet) string {
	return board.Drawing(s.Drawing, s.Box, "print-board leaf-drawing")
}

// SheetsPrint is a whiteboard's book for paper: every page, a letter sheet
// each, edge to edge.
templ SheetsPrint(b *db.Book, sheets []db.Sheet, marks map[int64]string) {
	@Doc(b.Title+" · print · draw", nil) {
		<div class="page leaf-page">
			<header class="pg-header app-header leaf-bar">
				<a class="button-like" href={ templ.SafeURL("/book/" + b.Name) }>
					@Icon("back")
					The book
				</a>
				<span class="meta">{ strconv.Itoa(len(sheets)) + " pages" }</span>
				<div class="row end">
					<button data-on:click="window.print()">
						@Icon("printer")
						Print
					</button>
				</div>
			</header>
			<main class="pg-main scroll-y leaf-main">
				for _, s := range sheets {
					@sheetPaper(b, s, marks[s.ID])
				}
			</main>
		</div>
		<script src="/static/highlight.js"></script>
		@mathAssets()
	}
}

// mathAssets: Temml (LaTeX to MathML) and a math font (Noto Sans Math has
// the OpenType MATH table MathML lays out with), for ```math blocks.
templ mathAssets() {
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Math&display=swap"/>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/temml@0.14.0/dist/Temml-Local.css"/>
	<script src="https://cdn.jsdelivr.net/npm/temml@0.14.0/dist/temml.min.js"></script>
}

// deletePageDialog asks before the page on the whiteboard leaves the book
// ($_delpage names it). Outside the strip's morph target: an update never
// closes it under the teacher's hand.
templ deletePageDialog(name string) {
	<dialog id="delete-page-confirm" class="modal content-1 confirm" closedby="any" aria-label="Delete the page" data-signals__ifmissing="{_delpage: 0, _delsheet: 0}">
		<h2>Delete page <span data-text="$_delpage"></span>?</h2>
		<p>It leaves the book, and the pages after it move up. If it is on the whiteboard, the whiteboard turns to a clean page; its history keeps the drawing.</p>
		<div class="row end">
			<button data-on:click="document.getElementById('delete-page-confirm').close()" autofocus>Cancel</button>
			<button class="dgr" data-on:click={ "@post('/b/" + name + "/sheet/' + $_delsheet + '/delete', {requestCancellation: 'disabled'}); document.getElementById('delete-page-confirm').close()" }>
				@Icon("trash")
				Delete
			</button>
		</div>
	</dialog>
}
