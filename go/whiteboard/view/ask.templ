package view

import (
	"strconv"
	"strings"
	"whiteboard/db"
	"whiteboard/hub"
)

// AskCard is a lesson's question over the board: a morph target on the
// board's stream, empty when there is none. Its viewer answers (a choice, or
// typed); everyone else on the board sees whose answer it waits for. Once
// answered it says how it went, for a moment.
templ AskCard(name string, u *db.User, q *hub.Ask) {
	<div id="lesson-ask" class="lesson-ask">
		if t := spoken(q); t != "" {
			<!-- narration: a new id per card, so it speaks once, as it lands -->
			<span id={ "speak-" + strconv.FormatInt(q.Version, 10) } hidden data-init="$_voice && speechSynthesis.speak(Object.assign(new SpeechSynthesisUtterance(el.textContent), {rate: 1.02}))">{ t }</span>
		}
		if q != nil && q.Done {
			<div class="ask-card card done" role="status" aria-label="Page done">
				<p class="q">That's this page.</p>
				<div class="options">
					if q.Next != "" {
						<a class="button-like" href={ templ.SafeURL("/b/" + q.Next) }>{ "Next: " + q.NextTitle + " →" }</a>
					} else {
						<a class="button-like" href={ templ.SafeURL("/book/" + q.Book) }>{ "The end of " + q.BookTitle + " · contents" }</a>
					}
				</div>
			</div>
		} else if q != nil && q.Say != "" {
			<div class="ask-card card say" role="status" aria-live="polite">
				<p>{ q.Say }</p>
			</div>
		} else if q != nil {
			<div class="ask-card card" role="dialog" aria-label="Question" data-ui-answered?={ q.Answered != "" } data-ui-correct?={ q.Answered != "" && q.Correct }>
				<p class="q">{ q.Question }</p>
				if q.Answered != "" {
					<p class="result">
						<strong>{ q.Answered }</strong>
						if q.Result != "" {
							<span>{ q.Result }</span>
						}
					</p>
				} else if u == nil || u.ID != q.ByID {
					<p class="meta">{ "Waiting for " + q.By + " to answer…" }</p>
				} else if len(q.Options) > 0 {
					<div class="options">
						for _, o := range q.Options {
							<button data-on:click={ answerPost(name, jsString(o)) }>{ o }</button>
						}
					</div>
				} else {
					<div class="row oneline free">
						<input type="text" maxlength="200" placeholder="Your answer" aria-label="Your answer" data-bind:_ans data-on:keydown={ "evt.stopPropagation(); if (evt.key === 'Enter' && $_ans.trim()) { " + answerPost(name, "$_ans") + " }" }/>
						<button data-on:click={ "$_ans.trim() && " + answerPost(name, "$_ans") }>Answer</button>
					</div>
				}
				if q.Help && q.Answered == "" && u != nil && u.ID == q.ByID {
					<button class="sec help" data-on:click={ "@post('/b/" + name + "/help', {payload: {inst: $inst}})" } title="Show me another way">I don't get it</button>
				}
				@Saved("ask")
			</div>
		}
	</div>
}

func answerPost(name, text string) string {
	return "@post('/b/" + name + "/answer', {payload: {text: " + text + ", inst: $inst}})"
}

// spoken is what narration reads of a card: the caption, the question (and
// its choices), or how the answer went.
func spoken(q *hub.Ask) string {
	switch {
	case q == nil || q.Done:
		return ""
	case q.Say != "":
		return q.Say
	case q.Answered != "":
		return q.Result
	case len(q.Options) > 0:
		return q.Question + " " + strings.Join(q.Options, ", or ") + "?"
	}
	return q.Question
}
