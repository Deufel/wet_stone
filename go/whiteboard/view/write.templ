package view

import "whiteboard/db"

// Writing a lesson book with the user's own Anthropic key. The dialog is a
// shell; its key line (#writer-key) and the drawer's status line
// (#writer-status) are morph targets the page's stream fills from the
// user's subject: the key set or not, a book being written, ready, or not.

// WriterState is what the two lines show.
type WriterState struct {
	Keys      []db.AIKey // the user's AI keys (the profile's AI tab)
	KeyEnd    string     // the active Anthropic key's last four characters; "" for none
	Workspace string // the workspace its requests name, if it needs one
	State     string // "", "writing", "ready" or "failed"
	Topic     string
	Title     string // the book, once ready
	Board     string // its first page
	Err       string
}

// openWriter: from the drawer, the dialog where there is one (home, a
// board), else home with it open.
const openWriter = "document.getElementById('nav-drawer')?.hidePopover(); " +
	"const d = document.getElementById('write-lesson'); d ? d.showModal() : location.assign('/#write')"

templ WriteDialog() {
	<dialog id="write-lesson" class="modal content-1 write-lesson" closedby="any" aria-label="Write a lesson" data-signals__ifmissing="{_topic: '', _pages: '4', _akey: '', _wfree: true}" data-init="location.hash === '#write' && el.showModal()">
		<header class="spread">
			<h3>Write a lesson book</h3>
			<button class="icon" data-on:click="document.getElementById('write-lesson').close()" aria-label="Close">
				@Icon("x")
			</button>
		</header>
		<div id="writer-key"></div>
		<div class="write-topic">
			<span id="write-topic-label">What should it teach?</span>
			<textarea rows="4" aria-labelledby="write-topic-label" maxlength="1500" placeholder="Go interfaces: what satisfies one, nil interfaces, embedding" data-bind:_topic data-on:keydown="evt.stopPropagation()"></textarea>
		</div>
		<div class="row spread">
			<label class="row oneline">
				<span>Pages</span>
				<select data-bind:_pages>
					<option value="1">1</option>
					<option value="4">about 4</option>
					<option value="8">about 8</option>
					<option value="14">about 14</option>
				</select>
			</label>
			<label class="row oneline free-draw" title="Claude draws its figures as SVG, animated, with buttons to run them">
				<input type="checkbox" data-bind:_wfree/>
				<span>Free draw</span>
			</label>
			<button class="suc" data-on:click="$_topic.trim() && @post('/lessons/write', {payload: {text: $_topic, n: +$_pages, free: $_wfree}})">
				@Icon("pen")
				Write it
			</button>
		</div>
		@Saved("write")
		<div id="writer-progress" class="writer-status"></div>
		<p class="meta">Each page teaches one idea, drawn on its own board, with notes, a checklist and a question or two. It takes a minute or two; the line above says when it is ready, with the way to it.</p>
	</dialog>
}

// WriterParts are the dialog's key line and the drawer's status line.
templ WriterParts(s WriterState) {
	<div id="writer-key" class="writer-key" data-signals={ "{_haskey: " + boolJS(s.KeyEnd != "") + "}" }>
		if s.KeyEnd == "" {
			@needKey("Lessons are written with your own AI key.")
		} else {
			<p class="meta">
				{ "Written with your Anthropic key ··" + s.KeyEnd + "." }
				<button class="link" data-on:click={ openAIKeys }>Your keys</button>
			</p>
		}
	</div>
	@MeAI(s.Keys)
	<div id="writer-status" class="writer-status">
		@writerLine(s)
	</div>
	<div id="writer-progress" class="writer-status">
		@writerLine(s)
	</div>
}

// writerLine: being written, ready (the way to it), or why not.
templ writerLine(s WriterState) {
	switch s.State {
		case "writing":
			<p class="meta" aria-live="polite">{ "Writing “" + s.Topic + "”…" }</p>
		case "ready":
			<a href={ templ.SafeURL("/b/" + s.Board) }>
				@Icon("book")
				{ "Ready: " + s.Title }
			</a>
		case "failed":
			<p class="meta dgr">{ "Not written: " + s.Err }</p>
	}
}

// openAIKeys opens your profile at its AI tab, from wherever asked.
const openAIKeys = "document.getElementById('write-lesson')?.close(); document.getElementById('sketch-menu')?.hidePopover(); " +
	"document.getElementById('nav-drawer')?.hidePopover(); $_metab = 'ai'; document.getElementById('me-menu').showPopover()"

// needKey: there is no active key; the way to add one is the profile.
templ needKey(why string) {
	<p class="meta need-key">
		{ why }
		<button class="link" data-on:click={ openAIKeys }>Add a key in your profile</button>
	</p>
}

// aiServices: the services a key may be for; only Anthropic so far.
var aiServices = []struct{ id, name string; ready bool }{
	{"anthropic", "Anthropic", true}, {"openai", "OpenAI", false}, {"google", "Google Gemini", false}, {"mistral", "Mistral", false},
}

// MeAI is the profile's AI tab: your keys (one active a service), a new
// one, and the services. A morph target on your stream.
templ MeAI(keys []db.AIKey) {
	<div id="me-ai" class="me-ai">
		<p class="meta">Claude writes lessons and draws with your own key. Keys stay on the server: a page never sees one again.</p>
		if len(keys) > 0 {
			<ul class="ai-keys">
				for _, k := range keys {
					<li data-ui-active?={ k.Active }>
						<div class="row oneline ai-key-head">
							<button
								class={ "switch", templ.KV("on", k.Active) }
								role="switch"
								aria-checked={ boolJS(k.Active) }
								title={ ifs(k.Active, "Active: click to turn it off", "Inactive: click to use this one") }
								data-on:click={ "@post('/me/keys/" + id64(k.ID) + "/" + ifs(k.Active, "off", "on") + "')" }
							></button>
							<strong>{ serviceName(k.Service) }</strong>
							<span class="meta">{ ifs(k.Label != "", k.Label+" · ", "") + "··" + k.Hint }</span>
							<button class="icon dgr" data-on:click={ "@post('/me/keys/" + id64(k.ID) + "/remove')" } aria-label="Remove this key" title="Remove this key">
								@Icon("trash")
							</button>
						</div>
						<div class="row oneline" data-signals={ "{_kws" + id64(k.ID) + ": " + jsString(k.Workspace) + "}" }>
							<input type="text" autocomplete="off" spellcheck="false" placeholder="Workspace ID, if it needs one" aria-label="Workspace ID" data-bind={ "_kws" + id64(k.ID) } data-on:keydown="evt.stopPropagation()"/>
							<button class="sec" data-on:click={ "@post('/me/keys/" + id64(k.ID) + "/workspace', {payload: {ws: $_kws" + id64(k.ID) + "}})" }>Save</button>
						</div>
					</li>
				}
			</ul>
		}
		<div class="ai-add" data-signals__ifmissing="{_akey: '', _alabel: '', _aws: ''}">
			<strong>Add a key</strong>
			<div class="row oneline">
				<select aria-label="Service">
					for _, sv := range aiServices {
						<option value={ sv.id } disabled?={ !sv.ready }>{ sv.name + ifs(sv.ready, "", " (coming soon)") }</option>
					}
				</select>
				<input type="text" placeholder="Label (optional)" maxlength="40" aria-label="Label" data-bind:_alabel data-on:keydown="evt.stopPropagation()"/>
			</div>
			<input type="password" autocomplete="off" placeholder="sk-ant-…" aria-label="API key" data-bind:_akey data-on:keydown="evt.stopPropagation()"/>
			<div class="row oneline">
				<input type="text" autocomplete="off" spellcheck="false" placeholder="Workspace ID, if it needs one (wrkspc_…)" aria-label="Workspace ID" data-bind:_aws data-on:keydown="evt.stopPropagation()"/>
				<button class="suc" data-on:click="$_akey.trim() && @post('/me/keys', {payload: {text: $_akey, label: $_alabel, ws: $_aws}}); $_akey = ''">Add</button>
			</div>
			@Saved("key")
		</div>
	</div>
}

func serviceName(id string) string {
	for _, s := range aiServices {
		if s.id == id {
			return s.name
		}
	}
	return id
}

func ifs(c bool, a, b string) string {
	if c {
		return a
	}
	return b
}
