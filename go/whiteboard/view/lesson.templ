package view

import "strconv"

// LessonState is the lesson player on a board, as the bar shows it.
type LessonState struct {
	Has     bool // the board carries a lesson
	Owner   bool // this viewer drives it
	Running bool // playing or paused
	Paused  bool
	Done    bool
	Step    int
	Of      int
	Speed   int // percent: 100 as written
	Version int64
}

// speeds are the player's: slower to read along, quicker to review.
var speeds = []int{50, 75, 100, 125, 150, 200}

func speedWord(p int) string {
	return strconv.FormatFloat(float64(p)/100, 'f', -1, 64) + "×"
}

func lessonPost(name, op string) string {
	return "@post('/b/" + name + "/lesson/" + op + "', {payload: {inst: $inst}, requestCancellation: 'disabled'})"
}

// LessonBar is the lesson's player, over the whiteboard's top-right corner:
// play or pause as a fab (its owner's), and a "…" fab opening the finer
// controls (from the start, back, speed, narration, the scrubber) in a
// popover. A morph target on the board's stream; empty with no lesson.
templ LessonBar(name string, st LessonState) {
	<div id="lesson-bar" class="lesson-fabs">
		if st.Has {
			if st.Owner {
				if st.Running && !st.Paused {
					<button class="fab-2 lesson-play" data-on:click={ "speechSynthesis.cancel(); " + lessonPost(name, "pause") } aria-label="Pause" title="Pause">
						@Icon("pause")
					</button>
				} else {
					<button class="fab-2 lesson-play" data-on:click={ lessonPost(name, "play") } aria-label="Play" title={ playTitle(st) }>
						@Icon("play")
					</button>
				}
			}
			<button class="fab-1 lesson-more" popovertarget="lesson-menu" aria-label="Lesson controls" title="Lesson controls">
				@Icon("more")
			</button>
			<div id="lesson-menu" class="menu lesson-menu" popover>
				if st.Owner {
					<button data-on:click={ "speechSynthesis.cancel(); " + lessonPost(name, "restart") }>
						@Icon("restart")
						From the start
					</button>
					<button data-on:click={ "speechSynthesis.cancel(); " + lessonPost(name, "back") }>
						@Icon("back")
						Back a step
					</button>
					<label class="row oneline speed-row">
						<span>Speed</span>
						<select class="speed" aria-label="Speed" data-on:change={ "@post('/b/" + name + "/lesson/speed', {payload: {n: +el.value, inst: $inst}, requestCancellation: 'disabled'})" }>
							for _, sp := range speeds {
								<option value={ strconv.Itoa(sp) } selected?={ sp == st.Speed || (st.Speed == 0 && sp == 100) }>{ speedWord(sp) }</option>
							}
						</select>
					</label>
				}
				<button data-on:click="$_voice = !$_voice; $_voice || speechSynthesis.cancel()" data-attr:aria-pressed="$_voice">
					<span data-show="$_voice">
						@Icon("volume")
					</span>
					<span data-show="!$_voice">
						@Icon("mute")
					</span>
					Narration
				</button>
				if st.Of > 0 {
					<label class="scrub-row">
						<span class="meta">{ "Step " + strconv.Itoa(st.Step) + " of " + strconv.Itoa(st.Of) }</span>
						<input class="scrub" type="range" min="0" max={ strconv.Itoa(st.Of) } value={ strconv.Itoa(st.Step) } disabled?={ !st.Owner } aria-label="Lesson position" data-on:change={ "speechSynthesis.cancel(); @post('/b/" + name + "/lesson/seek', {payload: {n: +el.value, inst: $inst}, requestCancellation: 'disabled'})" }/>
					</label>
				}
				@Saved("lesson")
			</div>
		}
	</div>
}

func playTitle(st LessonState) string {
	switch {
	case st.Paused:
		return "Play on"
	case st.Done:
		return "Play it again"
	}
	return "Play"
}

// SketchStop: while Claude draws on the board, the way to stop it (anyone
// on the board may). A morph target on the board's stream.
templ SketchStop(name string, drawing bool) {
	<div id="sketch-stop" class="sketch-stop">
		if drawing {
			<button class="tool stack dgr" data-on:click={ "@post('/b/" + name + "/sketch/stop', {requestCancellation: 'disabled'})" } aria-label="Stop Claude drawing" title="Stop Claude drawing">
				@Icon("square")
			</button>
		}
	</div>
}
