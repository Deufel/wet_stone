package view

import (
	"strconv"
	"whiteboard/db"
	"whiteboard/hub"
)

type BoardData struct {
	Inst string   // the server process this page landed on
	Name string
	Link string // the board's full URL, for sharing
	User *db.User
	Meta *hub.Meta
	Hist *hub.History
	Tabs []db.Tab
	// Lesson: the board carries a lesson (a lesson book's page)
	Lesson bool
	// Student: a book's whiteboard that is not theirs: a pencil of their own
	Student bool
}

// Board is the land: the whole document, rendered once. Everything after comes
// down the board's stream: <svg id="board">, drawn whole on the server for
// this viewer, as a morph, plus a few signals; the history (#history), the
// title (#board-title) and the share panel (#share-body) when they change. The
// page draws nothing itself; it carries the pointer and keys up as commands.
templ Board(d BoardData) {
	@Doc(d.Meta.Title+" · draw", nil) {
		<!-- the board's wiring sits on .page, in a fixed order: the signals are
		     declared before data-init reads them (a map of body attributes has no
		     order, and $uid once lost that race) -->
		<div class="page board-page" data-class:full="$_full" data-class:locked="$_locked || $_lessonOn" data-effect="($_locked || $_lessonOn) && $tool !== 4 && ($tool = 4)" data-signals={ pageSignals(d.Inst, boardHeight(d.Meta)) } data-effect={ aliveBeat } data-on-interval__duration.1s={ aliveCheck } data-init={ onInit(d.Name) } data-on:keydown__window={ onKey(d.Name) }>
			<!-- the teaching controls: the lesson, the page, Claude; then the
			     history and full screen (a phone: its tool menus first) -->
			@teachBar(d.Name, d.User != nil && d.Meta.OwnerID == d.User.ID, d.User)
			<!-- the tools, the selection's actions, undo: a rail at the left -->
			@toolRail(d.Name, d.Student, d.User, d.User != nil && d.Meta.OwnerID == d.User.ID)
			<!-- the workspace: the board, its checklist and your notes, laid out
			     by container queries on the space they get -->
			<main class="pg-main workspace-wrap">
				<div class="workspace" style={ "--ar: " + aspect(boardHeight(d.Meta)) }>
					@boardCard(d, boardHeight(d.Meta))
					@TodoCard(d.Name)
					@NotesCard(d.Name)
					<!-- the book this is the whiteboard of: its pages -->
					<div id="page-strip"></div>
				</div>
			</main>
		</div>
		<!-- the teacher's voice (a lesson's or Claude's): captions as toasts,
		     a question and its answers, in the bottom-right corner -->
		<div class="hud teach-hud">
			<div class="br column">
				@AskCard(d.Name, nil, nil)
			</div>
		</div>
		@navDrawer(d)
		@TodoDrawer(d.Name)
		@BudgetMenu(d.Name)
		@sketchMenu(d.Name)
		@panelMenus(d.Name)
		@clearDialog(d.Name)
		if d.User != nil && d.Meta.OwnerID == d.User.ID {
			@deletePageDialog(d.Name)
		}
		<aside id="history-drawer" class="drawer right history-drawer" popover="manual" aria-label="History">
			<header class="drawer-head">
				<h2>History</h2>
				<button class="icon" popovertarget="history-drawer" popovertargetaction="hide" aria-label="Close history">
					@Icon("x")
				</button>
			</header>
			@History(d.Name, d.Hist)
		</aside>
		<dialog id="share" class="modal share" closedby="any" aria-label="Share">
			<header class="drawer-head">
				<h2>Share</h2>
				<button class="icon" data-on:click="document.getElementById('share').close()" aria-label="Close">
					@Icon("x")
				</button>
			</header>
			@shareBody(d.Name, d.Link, d.User, d.Meta)
		</dialog>
		@keysDialog()
		@meMenu(d.User, true)
		@WriteDialog()
		@newMenu()
		<script src="/static/highlight.js"></script>
		@mathAssets()
	}
}

// teachBar is the subheader: the teaching controls (the lesson's player,
// sending the whiteboard to a page, Claude), then the history and full
// screen. A phone has its tool menus here too.
templ teachBar(name string, owner bool, u *db.User) {
	<nav class="pg-subheader teach-bar" aria-label="Teaching" data-class:acking="['sheet', 'sketch', 'label'].includes($_saved.k)">
		<div class="row oneline panel-menus mobile">
			<button class="icon" popovertarget="nav-drawer" aria-label="Menu" title="Menu">
				@Icon("menu")
			</button>
			<button class="icon tool-now" popovertarget="tools-menu" aria-label="Tools" title="Tools">
				for _, t := range tools {
					<span data-show={ "$tool === " + strconv.Itoa(t.n) }>
						@Icon(t.icon)
					</span>
				}
			</button>
			<button class="icon" popovertarget="acts-menu" aria-label="Selection" title="Selection">
				@Icon("more")
			</button>
		</div>
		<div class="row oneline ends">
			@Saved("sheet")
			@Saved("sketch")
			@Saved("label")
			<!-- a phone: no toolbar; the checklist (a top drawer), the history
			     and full screen here -->
			<span class="mobile row oneline">
				<button class="icon" popovertarget="sketch-menu" aria-label="Ask Claude to draw" title="Ask Claude to draw (beta)">
					@Icon("sparkles")
				</button>
				<button class="icon todo-open" popovertarget="todo-drawer" aria-label="Checklist" title="Checklist">
					@Icon("list")
				</button>
				<button class="icon" popovertarget="history-drawer" aria-label="History" title="History">
					@Icon("history")
				</button>
				<button class="icon" data-on:click="document.getElementById('share').showModal()" aria-label="Share" title="Share">
					@Icon("share")
				</button>
				<button class="icon" data-on:click={ fullToggle } aria-label="Full screen" title="Full screen">
					@Icon("maximize")
				</button>
				@avatarButton(u)
			</span>
		</div>
	</nav>
}

// toolRail is the toolbar: the drawing tools, then what to do with the
// selection, then undo and redo; square buttons, each key on hover.
templ toolRail(name string, student bool, u *db.User, owner bool) {
	if student {
		<!-- a student: a pencil of their own, and a way to clear it -->
		<nav class="pg-toolbar tool-rail tablet desktop" aria-label="Your pencil" data-init="$tool = 5">
			@railMenu()
			<div class="button-group tools" role="toolbar" aria-label="Your pencil">
				<button class="tool stack" aria-pressed="true" aria-label="Your pencil: only you see it" title="Your pencil: notes and questions only you see">
					@Icon("pen")
				</button>
				<button class="tool stack dgr" data-on:click={ "@post('/b/" + name + "/marks/clear')" } aria-label="Clear your marks" title="Clear your marks">
					@Icon("eraser")
				</button>
			</div>
			@railMe(u)
		</nav>
	} else {
	<nav class="pg-toolbar tool-rail tablet desktop" aria-label="Tools">
		@railMenu()
		<!-- Claude first: the board's strongest verb (.pri) -->
		<div class="button-group tools rail-ai" role="toolbar" aria-label="Claude">
			<button class="tool stack pri" popovertarget="sketch-menu" aria-label="Ask Claude to draw" title="Ask Claude to draw (beta)">
				@Icon("sparkles")
			</button>
			<div id="sketch-stop" class="sketch-stop"></div>
		</div>
		<!-- drawing: the tool in hand is the pressed one -->
		<div class="button-group tools" role="toolbar" aria-label="Drawing tools">
			@railTool(0, "select", "Select", "Esc")
			@railTool(1, "box", "Box", "R")
			@railTool(2, "line", "Line", "L")
			@railTool(3, "arrow", "Arrow", "A")
			@railTool(4, "laser", "Laser", "5")
			@railTool(5, "pen", "Pen", "P")
			@railTool(6, "code", "Code or math (```go, ```math)", "C")
		</div>
		<!-- motion: the selection turned (left click clockwise, right click
		     counter-clockwise); each icon turns as its button does -->
		<div class="button-group tools rail-sec motion" role="toolbar" aria-label="Turn" data-signals__ifmissing="{_r45: 0, _r30: 0}">
			@turnTool(name, 45)
			@turnTool(name, 30)
		</div>
		<!-- the selection -->
		<div class="button-group tools rail-sec" role="toolbar" aria-label="The selection">
			<button class="tool stack sec" data-on:click={ post(name, "group") } data-attr:disabled="$nsel < 2" aria-label="Group" title="Group">
				@Icon("group")
				<kbd>G</kbd>
			</button>
			<button class="tool stack sec" data-on:click={ post(name, "ungroup") } data-attr:disabled="!$grouped" aria-label="Ungroup" title="Ungroup">
				@Icon("ungroup")
				<span class="keys"><kbd class="mod">shift</kbd><kbd>G</kbd></span>
			</button>
			<button class="tool stack sec" data-on:click={ post(name, "delete") } data-attr:disabled="$nsel < 1" aria-label="Delete" title="Delete">
				@Icon("trash")
				<kbd>Del</kbd>
			</button>
			<button class="tool stack sec dgr" data-on:click="document.getElementById('clear-confirm').showModal()" aria-label="Clear the board" title="Clear the board">
				@Icon("eraser")
			</button>
		</div>
		<!-- time: undo, redo, the whole history -->
		<div class="button-group tools rail-sec" role="toolbar" aria-label="History">
			<button class="tool stack sec" data-on:click={ postKept(name, "undo") } aria-label="Undo" title="Undo (Ctrl Z)">
				@Icon("undo")
				<span class="keys"><kbd class="mod">ctrl</kbd><kbd>Z</kbd></span>
			</button>
			<button class="tool stack sec" data-on:click={ postKept(name, "redo") } aria-label="Redo" title="Redo (Ctrl R)">
				@Icon("redo")
				<span class="keys"><kbd class="mod">ctrl</kbd><kbd>R</kbd></span>
			</button>
			<button class="tool stack sec" popovertarget="history-drawer" aria-label="History" title="History (Shift H)">
				@Icon("history")
				<span class="keys"><kbd class="mod">shift</kbd><kbd>H</kbd></span>
			</button>
		</div>
		<!-- at the foot: the page (send, or save the page back on the
		     whiteboard; the board's stream fills it), and full screen -->
		<div class="rail-foot">
			<div id="page-save" class="button-group tools page-save"></div>
			<div class="button-group tools rail-sec" role="toolbar" aria-label="Share">
				<button class="tool stack sec" data-on:click="document.getElementById('share').showModal()" aria-label="Share" title="Share">
					@Icon("share")
				</button>
				if owner {
					<!-- locked, only the laser marks the board; a lesson page keeps it locked -->
					<button
						class="tool stack sec keep lock-tool"
						data-attr:aria-pressed="($_locked || $_lessonOn) ? 'true' : 'false'"
						data-attr:disabled="$_lessonOn"
						data-attr:title="$_lessonOn ? 'A lesson page stays locked: only the laser' : $_locked ? 'Locked: only the laser marks it. Click to unlock' : 'Lock it: only the laser marks it'"
						aria-label="Lock the board"
						data-on:click={ "@post('/b/" + name + "/share/' + ($_locked ? 'unlock' : 'lock'))" }
					>
						<span data-show="$_locked || $_lessonOn">
							@Icon("lock")
						</span>
						<span data-show="!($_locked || $_lessonOn)">
							@Icon("unlock")
						</span>
					</button>
				}
			</div>
			<div class="button-group tools rail-sec" role="toolbar" aria-label="View">
				<button class="tool stack sec" data-on:click={ fullToggle } aria-label="Full screen" title="Full screen (F)">
					<span data-show="!$_full">
						@Icon("maximize")
					</span>
					<span data-show="$_full">
						@Icon("minimize")
					</span>
					<kbd>F</kbd>
				</button>
			</div>
			@railMe(u)
		</div>
	</nav>
	}
}

// railMenu is the rail's head: the menu (your boards, lessons, this board).
templ railMenu() {
	<div class="button-group tools rail-menu">
		<button class="tool stack sec" popovertarget="nav-drawer" aria-label="Menu" title="Menu: your boards and lessons">
			@Icon("menu")
		</button>
	</div>
}

// railMe is the rail's foot: you, as a stack of your own (your avatar opens
// your profile: theme, boards, shortcuts, sign out).
templ railMe(u *db.User) {
	<div class="rail-me">
		@avatarButton(u)
	</div>
}

// turnTool turns the selection by deg: a left click clockwise, a right
// click (the context menu, kept from opening) counter-clockwise; its icon
// turns the same way, by a signal of its own.
templ turnTool(name string, deg int) {
	<button
		class="tool stack sec"
		data-on:click={ "$_r" + strconv.Itoa(deg) + "++; " + post(name, "cw"+strconv.Itoa(deg)) }
		data-on:contextmenu={ "evt.preventDefault(); $_r" + strconv.Itoa(deg) + "--; " + post(name, "ccw"+strconv.Itoa(deg)) }
		data-attr:disabled="$nsel < 1"
		aria-label={ "Turn " + strconv.Itoa(deg) + "°" }
		title={ "Turn " + strconv.Itoa(deg) + "°: click clockwise, right click counter-clockwise" }
	>
		<span class="mo" data-attr:style={ "`transform: rotate(${$_r" + strconv.Itoa(deg) + " * " + strconv.Itoa(deg) + "}deg); transition: transform 0.3s ease`" }>
			@Icon("turn")
		</span>
		<kbd>{ strconv.Itoa(deg) + "°" }</kbd>
	</button>
}

// boardCard is the whiteboard: the paper, and a lesson's question over it.
templ boardCard(d BoardData, h int32) {
	{{ name := d.Name }}
	<section class="card board-card" data-init={ fullSync } aria-label="Whiteboard">
		<!-- the lesson's player, over the paper's top-right corner -->
		<div id="lesson-bar" class="lesson-fabs"></div>
		<div class="stage-box">
			<div class="stage-frame">
				<div
					id="stage"
					data-on:pointerdown={ onDown(name) }
					data-on:pointermove__window={ onMove(name) }
					data-on:pointerup__window={ onUp(name) }
					data-on:pointercancel={ onLost(name) }
					data-on:lostpointercapture={ onLost(name) }
					data-on:dblclick={ onDblclick(name) }
					data-on:contextmenu={ onContext(name) }
				>
					@grid(h)
					<svg id="board" xmlns="http://www.w3.org/2000/svg" viewBox={ "0 0 1000 " + strconv.Itoa(int(h)) }></svg>
					@boardTitle(d.Name, d.User, d.Meta)
					<!-- a student's own marks, over the board (their stream fills it) -->
					<svg id="marks" class="marks" xmlns="http://www.w3.org/2000/svg" viewBox={ "0 0 1000 " + strconv.Itoa(int(h)) }></svg>
				<!-- the label editor: opened over a shape's label box (a double-click,
				     a click on its label, Enter), typed in place, sent on leaving it;
				     the server draws the label back into the shape -->
				<div
					id="label-edit"
					class="label-edit"
					contenteditable="plaintext-only"
					spellcheck="false"
					role="textbox"
					aria-label="Label"
					data-show="$_ledit"
					data-style={ labelBoxStyle }
					data-effect={ labelOpen }
					data-on:keydown={ labelKeys }
					data-on:input="el.classList.toggle('code', el.innerText.trimStart().startsWith('```'))"
					data-on:blur={ labelCommit(name) }
					data-on:pointerdown="evt.stopPropagation()"
				></div>
				</div>
			</div>
		</div>
	</section>
}

// panelMenus are the phone's tool and selection menus (the board's panel
// shows them inline on anything wider).
templ panelMenus(name string) {
	<div id="tools-menu" class="menu panel-menu" popover aria-label="Tools">
		for _, t := range tools {
			<button data-on:click={ pick(t.n) + "; document.getElementById('tools-menu').hidePopover()" } data-attr:aria-pressed={ pressed(t.n) }>
				@Icon(t.icon)
				{ t.label }
			</button>
		}
	</div>
	<div id="acts-menu" class="menu panel-menu" popover aria-label="Selection">
		<button data-on:click={ post(name, "group") + "; document.getElementById('acts-menu').hidePopover()" } data-attr:disabled="$nsel < 2">
			@Icon("group")
			Group
		</button>
		<button data-on:click={ post(name, "ungroup") + "; document.getElementById('acts-menu').hidePopover()" } data-attr:disabled="!$grouped">
			@Icon("ungroup")
			Ungroup
		</button>
		<button data-on:click={ post(name, "delete") + "; document.getElementById('acts-menu').hidePopover()" } data-attr:disabled="$nsel < 1">
			@Icon("trash")
			Delete
		</button>
		<hr/>
		<button class="dgr" data-on:click="document.getElementById('acts-menu').hidePopover(); document.getElementById('clear-confirm').showModal()">
			@Icon("eraser")
			Clear the board
		</button>
	</div>
}

type tool struct {
	n           int
	icon, label string
}

var tools = []tool{{0, "select", "Select"}, {1, "box", "Box"}, {2, "line", "Line"}, {3, "arrow", "Arrow"}, {4, "laser", "Laser"}, {5, "pen", "Pen"}, {6, "code", "Code"}}

// clearDialog: clearing the board asks first (the history still keeps it).
templ clearDialog(name string) {
	<dialog id="clear-confirm" class="modal content-1 confirm" closedby="any" aria-label="Clear the board">
		<h2>Clear the board?</h2>
		<p>Everything drawn goes. The history keeps it: you can step back to it from there.</p>
		<div class="row end">
			<button data-on:click="document.getElementById('clear-confirm').close()" autofocus>Cancel</button>
			<button class="dgr" data-on:click={ post(name, "clear") + "; document.getElementById('clear-confirm').close()" }>
				@Icon("eraser")
				Clear
			</button>
		</div>
	</dialog>
}

// navDrawer opens from the logo: your boards, a new one, this board on paper.
templ navDrawer(d BoardData) {
	<aside id="nav-drawer" class="drawer left nav-drawer" popover aria-label="Menu">
		@drawerHead()
		<nav class="nav-list" aria-label="Menu">
			<a href="/">
				@Icon("home")
				Home
			</a>
			<section class="nav-sec" aria-label="Boards" data-init={ navSecInit("Boards") }>
				<button class="nav-sec-head" aria-expanded="true" data-on:click={ navSecToggle("Boards") }>
					<h3>Boards</h3>
					@Icon("chevron")
				</button>
				@DrawerBoards(d.Name, d.Meta, d.Tabs)
				@newBoardRow()
			</section>
			<section class="nav-sec" aria-label="Books" data-init={ navSecInit("Books") }>
				<button class="nav-sec-head" aria-expanded="true" data-on:click={ navSecToggle("Books") }>
					<h3>Books</h3>
					@Icon("chevron")
				</button>
				<a href="/#books">
					@Icon("home")
					Your books
				</a>
				@newBookRow()
			</section>
			@learnSection()
			<section class="nav-sec" aria-label="This board" data-init={ navSecInit("This board") }>
				<button class="nav-sec-head" aria-expanded="true" data-on:click={ navSecToggle("This board") }>
					<h3>This board</h3>
					@Icon("chevron")
				</button>
				<a href={ templ.SafeURL("/b/" + d.Name + "/print") }>
					@Icon("printer")
					Print
				</a>
				<button data-on:click="document.getElementById('keys').showModal()">
					@Icon("keys")
					Keyboard shortcuts
				</button>
			</section>
		</nav>
		<p class="fine"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
	</aside>
}

templ railTool(n int, icon, label, key string) {
	<!-- a .stack: the icon, and its key over it, shown on hover -->
	<button class={ "tool stack", templ.KV("keep", n == 4) } data-on:click={ pick(n) } data-attr:aria-pressed={ pressed(n) } aria-label={ label } title={ label }>
		@Icon(icon)
		if key != "" {
			<kbd>{ key }</kbd>
		}
	</button>
}

// boardTitle: the board's name and who may open it (a morph target, so a
// rename shows everywhere at once). <title> is in the head, which the stream
// never re-renders, so the name rides a re-merged signal to it.
// The owner renames it in place: a click makes the name editable, Enter or
// leaving saves, Esc puts it back.
templ boardTitle(name string, u *db.User, m *hub.Meta) {
	<!-- the board's title is on the paper, in its units, where it prints: an
	     input its owner types into; under it who may open it and who is here
	     (those two are the screen's, not the paper's) -->
	<svg id="board-title" class="paper-head" xmlns="http://www.w3.org/2000/svg" viewBox={ "0 0 1000 " + strconv.Itoa(int(boardHeight(m))) } data-signals={ "{_doctitle: " + jsString(m.Title+" · draw") + ", _locked: " + boolJS(m.Locked) + "}" } data-effect="document.title = $_doctitle">
		<foreignObject x="28" y="18" width="944" height="84">
			<div xmlns="http://www.w3.org/1999/xhtml" class="paper-head-in">
				if u != nil && u.ID == m.OwnerID {
					<input class="paper-title" type="text" maxlength="60" value={ m.Title } aria-label="Board title" title="Click to rename" spellcheck="false" { paperTitleEdit(name)... }/>
				} else {
					<span class="paper-title">{ m.Title }</span>
				}
				<div class="paper-meta">
					if u != nil && u.ID == m.OwnerID && m.Visibility != db.Global {
						<button class="vis vis-btn" popovertarget="vis-menu" title="Who can open this board" data-on:pointerdown="evt.stopPropagation()">
							@visIcon(m.Visibility)
							{ visWord(m.Visibility) }
							@Icon("chevron")
						</button>
						<div id="vis-menu" class="menu vis-menu" popover>
							<button data-on:click={ "@post('/b/" + name + "/share/public'); document.getElementById('vis-menu').hidePopover()" } aria-pressed={ strconv.FormatBool(m.Visibility == db.Public) }>
								@Icon("link")
								<span>
									<strong>Anyone with the link</strong>
									<small>can open it and draw</small>
								</span>
							</button>
							<button data-on:click={ "@post('/b/" + name + "/share/private'); document.getElementById('vis-menu').hidePopover()" } aria-pressed={ strconv.FormatBool(m.Visibility == db.Private) }>
								@Icon("lock")
								<span>
									<strong>Private</strong>
									<small>you and the people you invite</small>
								</span>
							</button>
						</div>
					} else {
						<span class="vis">
							@visIcon(m.Visibility)
							{ visWord(m.Visibility) }
						</span>
					}
					<span class="presence" title="People on this board"><span data-text="$users"></span> here</span>
					@Saved("title")
				</div>
			</div>
		</foreignObject>
	</svg>
}

// DrawerBoards is the drawer's list of your boards: a morph target on the
// board's stream, sent again whenever your boards change on any device.
templ DrawerBoards(name string, m *hub.Meta, tabs []db.Tab) {
	<div id="drawer-boards" class="drawer-boards">
		for _, t := range withCurrent(name, m, tabs) {
			<a href={ templ.SafeURL("/b/" + t.Name) } aria-current?={ t.Name == name }>
				@visIcon(t.Visibility)
				{ t.Title }
			</a>
		}
	</div>
}

templ newMenu() {
	<div id="new-menu" class="menu new-menu" popover>
		<button class="oneline" data-on:click={ newBoard(db.Public) }>
			@Icon("link")
			New public board
		</button>
		<button class="oneline" data-on:click={ newBoard(db.Private) }>
			@Icon("lock")
			New private board
		</button>
	</div>
}

templ keysDialog() {
	<dialog id="keys" class="modal keys" closedby="any" aria-label="Keyboard shortcuts">
		<header class="drawer-head">
			<h2>Shortcuts</h2>
			<button class="icon" data-on:click="document.getElementById('keys').close()" aria-label="Close">
				@Icon("x")
			</button>
		</header>
		<dl class="keylist">
			<dt><kbd>R</kbd> <kbd>L</kbd> <kbd>A</kbd> <kbd>5</kbd> <kbd>P</kbd></dt>
			<dd>box, line, arrow, laser, pen</dd>
			<dt><kbd class="mod">ctrl</kbd><kbd>Z</kbd> · <kbd class="mod">ctrl</kbd><kbd>R</kbd></dt>
			<dd>undo · redo</dd>
			<dt><kbd>Esc</kbd></dt>
			<dd>the select tool</dd>
			<dt><kbd>H</kbd> <kbd>J</kbd> <kbd>K</kbd> <kbd>L</kbd></dt>
			<dd>nudge the selection (in the select tool); the arrows anywhere</dd>
			<dt><kbd>Enter</kbd></dt>
			<dd>label the selected shape; Enter again to finish</dd>
			<dt><kbd>G</kbd> · <kbd class="mod">shift</kbd><kbd>G</kbd></dt>
			<dd>group · ungroup</dd>
			<dt><kbd>Del</kbd></dt>
			<dd>delete the selection</dd>
			<dt><kbd class="mod">shift</kbd><kbd>H</kbd></dt>
			<dd>show or hide the history</dd>
			<dt><kbd>F</kbd></dt>
			<dd>the whiteboard full screen, or back</dd>
			<dt><kbd>?</kbd></dt>
			<dd>these shortcuts</dd>
			<dt>drag on empty paper</dt>
			<dd>select: downward takes what it touches, upward only what it encloses</dd>
			<dt>double-click</dt>
			<dd>link or unlink where ends and corners meet; on a shape, edit its label</dd>
			<dt>right-click</dt>
			<dd>lock a shape onto what overlaps it, or unlock it</dd>
		</dl>
	</dialog>
}

// The grid is static: never morphed, never re-sent. Each pattern is offset by
// half a tile so its mark lands on the snap lattice (multiples of 20 and 100).
templ grid(h int32) {
	<svg class="grid" xmlns="http://www.w3.org/2000/svg" viewBox={ "0 0 1000 " + strconv.Itoa(int(h)) } aria-hidden="true">
		<defs>
			<pattern id="minor" width="20" height="20" x="-10" y="-10" patternUnits="userSpaceOnUse"><path class="plus" d="M7 10h6M10 7v6"></path></pattern>
			<pattern id="major" width="100" height="100" x="-50" y="-50" patternUnits="userSpaceOnUse"><path class="major" d="M50 0v100M0 50h100"></path></pattern>
		</defs>
		<rect x="-30" y="-30" width="1060" height={ strconv.Itoa(int(h) + 60) } fill="url(#major)"></rect>
		<rect x="-30" y="-30" width="1060" height={ strconv.Itoa(int(h) + 60) } fill="url(#minor)"></rect>
	</svg>
}

// boardHeight is the board's height in units: 1000 square, or a letter page.
func boardHeight(m *hub.Meta) int32 {
	if m == nil || m.Height <= 0 {
		return 1000
	}
	return m.Height
}

// aspect is the board's height over its width, for the paper's frame (CSS).
func aspect(h int32) string { return strconv.FormatFloat(float64(h)/1000, 'f', 4, 64) }

// withCurrent keeps the board on screen in the strip even when it was just
// closed from another device: you are still looking at it.
func withCurrent(name string, m *hub.Meta, tabs []db.Tab) []db.Tab {
	for _, t := range tabs {
		if t.Name == name {
			return tabs
		}
	}
	return append(tabs, db.Tab{Name: name, Title: m.Title, Visibility: m.Visibility})
}

func visWord(v string) string {
	switch v {
	case db.Global:
		return "everyone"
	case db.Private:
		return "private"
	}
	return "anyone with the link"
}

// sketchMenu asks Claude to draw: at page level, so a phone (no toolbar)
// opens it too from its bar.
templ sketchMenu(name string) {
	<div id="sketch-menu" class="menu sketch-menu" popover data-signals__ifmissing="{_sketch: '', _free: false, _haskey: true}">
		<p class="meta">Claude draws it on this board, around what is there. <span class="tag">beta</span></p>
		<div data-show="!$_haskey">
			@needKey("Claude draws with your own AI key.")
		</div>
		<label class="row oneline free-draw" title="Claude may draw any SVG it likes, animated">
			<input type="checkbox" data-bind:_free/>
			<span>Free draw: any figure, animated</span>
		</label>
		<div class="row oneline">
			<input type="text" maxlength="800" placeholder="Sketch how a hash map finds a key" aria-label="What should Claude draw?" data-bind:_sketch data-on:keydown={ "evt.stopPropagation(); if (evt.key === 'Enter' && $_sketch.trim()) { " + sketchPost(name) + " }" }/>
			<button class="suc" data-on:click={ "$_sketch.trim() && " + sketchPost(name) }>Draw</button>
		</div>
	</div>
}
