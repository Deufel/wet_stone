package view

import "whiteboard/db"

// Privacy is the privacy policy Google's consent screen links to. It says what
// the code actually does; keep the two in step.
templ Privacy(u *db.User) {
	@Doc("draw · privacy", nil) {
		<div class="page home">
			@appHeader(u)
			<main class="pg-main scroll-y">
				<div class="home-body legal">
					<h2>Privacy</h2>
					<p class="hint">draw at draw.deufel.dev is a small whiteboard run by Michael Deufel. Last updated October 15, 2026.</p>
					<h3>What is stored</h3>
					<ul>
						<li><strong>Your Google account basics.</strong> When you sign in with Google, draw receives and keeps your name, email address, profile picture link and Google's account identifier. Nothing else from your Google account is requested or read.</li>
						<li><strong>What you draw.</strong> Boards you make or draw on, their titles, labels, history and branches, and the email addresses you invite to a private board.</li>
						<li><strong>A session cookie.</strong> One cookie keeps you signed in; it holds a random token, and the server keeps only a hash of it. Your theme choice is kept in your browser's local storage.</li>
					</ul>
					<p>Cursor positions, selections and laser strokes are shared live with the other people on a board and are never stored.</p>
					<h3>Who sees it</h3>
					<p>The people on a board see what is drawn on it and the first names of whoever is present. The global board and public boards are open to anyone signed in (public ones to anyone with the link); a private board, to its owner and the people invited. There is no advertising, no analytics or tracking, and nothing is sold or shared with anyone else. Data lives on a server operated by the site's owner.</p>
					<h3>Removing it</h3>
					<p>Sign out at any time. To have your account and the boards you own deleted, email <a href="mailto:mdeufel13@gmail.com">mdeufel13@gmail.com</a>.</p>
					<p><a href="/">Back to draw</a></p>
				</div>
			</main>
		</div>
		if u == nil {
			@ThemeMenu()
		}
		if u != nil {
			@MeMenu(u)
		}
	}
}

// Terms are the terms of service Google's consent screen links to.
templ Terms(u *db.User) {
	@Doc("draw · terms", nil) {
		<div class="page home">
			@appHeader(u)
			<main class="pg-main scroll-y">
				<div class="home-body legal">
					<h2>Terms</h2>
					<p class="hint">For draw at draw.deufel.dev. Last updated October 15, 2026.</p>
					<p>draw is a free, small, hobby service, offered as it is, with no warranty and no promise that it will be available or that what you draw will be kept. Keep copies of anything that matters.</p>
					<p>Be decent on shared boards: do not post anything illegal, abusive, or that you have no right to share. Boards or accounts that break this may be removed.</p>
					<p>What you draw stays yours. By drawing on a board you let the service store it and show it to the people that board is shared with.</p>
					<p>The software is open source under the MIT license: <a href="https://github.com/Deufel/wet_stone">github.com/Deufel/wet_stone</a>. Questions: <a href="mailto:mdeufel13@gmail.com">mdeufel13@gmail.com</a>.</p>
					<p><a href="/">Back to draw</a></p>
				</div>
			</main>
		</div>
		if u == nil {
			@ThemeMenu()
		}
		if u != nil {
			@MeMenu(u)
		}
	}
}
