package view

import (
	"net/url"
	"whiteboard/db"
)

type LandingData struct {
	Next   string // where to go after signing in
	Google bool   // Google sign-in is configured
	Dev    bool   // the local dev sign-in is on
}

// Landing is the front door for a visitor.
templ Landing(d LandingData) {
	@Doc("draw · think on paper, together", nil) {
		<div class="page landing">
			@appHeader(nil) {
				if d.Google {
					<hr/>
					<!-- a navigation to Google, not a command -->
					<button class="google" data-on:click={ "window.location.href = " + jsString(googleURL(d.Next)) }>
						@googleG()
						Sign in
					</button>
				}
			}
			<main class="pg-main scroll-y">
				<div class="intro">
					<div class="intro-mark">
						@Mark()
					</div>
					<h1>Think on paper, together.</h1>
					<p class="lede">A live whiteboard for small teams: boxes, lines and arrows that link and follow each other, a laser pointer for showing, and a history you can step back through and branch from.</p>
					if d.Dev || !d.Google {
						<div class="signin">
							if d.Dev {
								<div class="row dev" data-signals={ devSignals(d.Next) }>
									<input type="email" placeholder="you@example.com" data-bind:email data-on:keydown="evt.key === 'Enter' && @post('/auth/dev')" aria-label="Email (local sign-in)"/>
									<button data-on:click="@post('/auth/dev')">Sign in (local)</button>
									@Saved("email")
								</div>
							}
							if !d.Google && !d.Dev {
								<p class="hint">Sign-in is not configured on this server yet.</p>
							}
						</div>
					}
					<ul class="features">
						<li><strong>Live.</strong> Everyone on a board sees every stroke as it happens. The server draws the whole picture; your browser only shows it.</li>
						<li><strong>Branching history.</strong> Every change is kept. Jump back to any moment, and draw a new branch from there.</li>
						<li><strong>Yours, or everyone's.</strong> Draw on the global board, a public board anyone with the link can join, or a private board for the people you invite.</li>
					</ul>
					<p class="fine"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="https://github.com/Deufel/wet_stone">Source</a></p>
				</div>
			</main>
		</div>
		@ThemeMenu()
	}
}

// Home is a signed-in user's front page: start or join a board, or go back
// to one of theirs.
templ Home(u *db.User, tabs []db.Tab, books []db.Book, thumbs map[string]string) {
	@Doc("draw · your library", nil) {
		<div class="page home" data-signals={ "{" + savedSignal + ", _beat: 0, _rm: {name: '', title: ''}}" } data-effect={ aliveBeat } data-on-interval__duration.1s={ aliveCheck } data-init={ streamGet("/stream") }>
			@appHeader(u)
			<main class="pg-main scroll-y">
				<!-- the library: everything of yours, as it looks; the drawer is
				     the quick way between them, this is the whole shelf -->
				<div class="home-body library">
					<header class="lib-head">
						<h2>{ "Hello, " + u.First() + "." }</h2>
						<div class="lib-actions">
							<button class="pri" data-on:click={ newBoard(db.Public) } title="A new board anyone with the link can draw on">
								@Icon("plus")
								New board
							</button>
							<button class="sec" data-on:click={ newBoard(db.Private) } title="A new board only you and the people you invite open">
								@Icon("lock")
								Private board
							</button>
							<button class="sec" data-on:click="@post('/books/new/public')" title="A new book: a whiteboard and its pages">
								@Icon("book")
								New book
							</button>
							<button class="sec" data-on:click={ openWriter } title="Claude writes a lesson book with your key">
								@Icon("sparkles")
								Write a lesson
							</button>
							<a class="lib-global" href="/b/main" title="Everyone signed in draws here">
								@Icon("globe")
								Global board
							</a>
						</div>
					</header>
					@HomeBoards(tabs, books, thumbs)
				</div>
			</main>
		</div>
		@removeDialog()
		@MeMenu(u)
		@WriteDialog()
	}
}

// Private is the answer to a board the user may not open.
templ Private(u *db.User) {
	@Doc("draw · private board", nil) {
		<div class="page home">
			@appHeader(u)
			<main class="pg-main scroll-y">
				<div class="home-body notice">
					@Icon("lock")
					<h2>This board is private.</h2>
					<p>{ "Ask its owner to invite " + u.Email + "." }</p>
					<p><a href="/">Back to your boards</a></p>
				</div>
			</main>
		</div>
		@MeMenu(u)
	}
}

templ NotFound(u *db.User) {
	@Doc("draw · not found", nil) {
		<div class="page home">
			@appHeader(u)
			<main class="pg-main scroll-y">
				<div class="home-body notice">
					<h2>There is no board here.</h2>
					<p><a href="/">Back to the front page</a></p>
				</div>
			</main>
		</div>
		if u == nil {
			@ThemeMenu()
		}
		if u != nil {
			@MeMenu(u)
		}
	}
}

// appHeader is the header of the front pages: the brand, the theme, you, and
// whatever the page adds after them (the landing: a rule, then sign-in).
templ appHeader(u *db.User) {
	<header class="pg-header app-header">
		if u != nil {
			<button class="brand" popovertarget="nav-drawer" aria-label="Menu" title="Menu">
				@Mark()
				<span>draw</span>
			</button>
			@frontDrawer()
		} else {
			<a class="brand" href="/">
				@Mark()
				<span>draw</span>
			</a>
		}
		<div class="row end">
			if u != nil {
				@avatarButton(u)
			} else {
				<button class="icon" popovertarget="theme-menu" aria-label="Theme" title="Theme">
					@Icon("palette")
				</button>
			}
			{ children... }
		</div>
	</header>
}

templ avatarButton(u *db.User) {
	<button class="avatar me" popovertarget="me-menu" aria-label={ "Account: " + u.Email } title={ u.Email }>
		if u.Picture != "" {
			<img src={ u.Picture } alt="" referrerpolicy="no-referrer"/>
		} else {
			{ initial(u) }
		}
	</button>
}

// MeMenu: who you are, and the way out.
templ MeMenu(u *db.User) {
	@meMenu(u, false)
}

// meMenu is your profile card: who you are, sign out; then your theme, your
// boards and (on a board) its keyboard shortcuts.
templ meMenu(u *db.User, board bool) {
	<div id="me-menu" class="menu me-menu" popover data-signals__ifmissing="{_metab: 'profile'}">
		<header class="me-head">
			<span class="avatar me-pic">
				if u.Picture != "" {
					<img src={ u.Picture } alt="" referrerpolicy="no-referrer"/>
				} else {
					{ initial(u) }
				}
			</span>
			<div class="who">
				<strong>{ u.Name }</strong>
				<span>{ u.Email }</span>
			</div>
			<button class="sign-out" data-on:click="@post('/auth/logout')">Sign out</button>
			<button class="icon" popovertarget="me-menu" popovertargetaction="hide" aria-label="Close">
				@Icon("x")
			</button>
		</header>
		<nav class="tabs-underline me-tabs" role="tablist" aria-label="Your profile">
			<button role="tab" data-attr:aria-selected="$_metab === 'profile'" data-on:click="$_metab = 'profile'">Profile</button>
			<button role="tab" data-attr:aria-selected="$_metab === 'prefs'" data-on:click="$_metab = 'prefs'">Preferences</button>
			<button role="tab" data-attr:aria-selected="$_metab === 'ai'" data-on:click="$_metab = 'ai'">
				@Icon("sparkles")
				<span>AI</span>
			</button>
		</nav>
		<section class="me-panel" data-show="$_metab === 'profile'">
			if board {
				<button data-on:click="document.getElementById('me-menu').hidePopover(); document.getElementById('nav-drawer').showPopover()">
					@Icon("book")
					Boards and lessons
				</button>
			}
			<a href="/">
				@Icon("home")
				Your boards
			</a>
		</section>
		<section class="me-panel" data-show="$_metab === 'prefs'">
			<div class="me-theme">
				@ThemeControls()
			</div>
			if board {
				<button data-on:click="document.getElementById('me-menu').hidePopover(); document.getElementById('keys').showModal()">
					@Icon("keys")
					Keyboard shortcuts
				</button>
			}
		</section>
		<section class="me-panel" data-show="$_metab === 'ai'">
			<div id="me-ai" class="me-ai">
				<p class="meta">Your keys show here on your home page and your boards.</p>
			</div>
		</section>
	</div>
}

templ visIcon(v string) {
	switch v {
		case db.Global:
			@Icon("globe")
		case db.Private:
			@Icon("lock")
		default:
			@Icon("link")
	}
}

templ googleG() {
	<svg class="g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg>
}

// HomeBoards is the front page's board list: a morph target on the front
// page's stream, sent again whenever the user's boards change anywhere.
templ HomeBoards(tabs []db.Tab, books []db.Book, thumbs map[string]string) {
	<section id="home-boards" class="home-boards">
		<h3 id="books">Books</h3>
		if len(books) == 0 {
			<p class="hint">No books yet: a book is a whiteboard and the pages you send from it.</p>
		} else {
			<ul class="lib-grid">
				for _, b := range books {
					<li class="lib-card">
						<a href={ templ.SafeURL("/book/" + b.Name) }>
							<span class="lib-thumb">
								@templ.Raw(thumbs["book:"+b.Name])
							</span>
							<span class="lib-name">
								@Icon("book")
								<strong>{ b.Title }</strong>
							</span>
							<span class="meta">{ visWord(b.Visibility) }</span>
						</a>
					</li>
				}
			</ul>
		}
		{{ boards := libraryBoards(tabs, books) }}
		<h3>Boards</h3>
		if len(boards) == 0 {
			<p class="hint">No boards yet: start one above.</p>
		} else {
			<ul class="lib-grid">
				for _, t := range boards {
					<li class="lib-card" id={ "tab-" + t.Name }>
						<a href={ templ.SafeURL("/b/" + t.Name) }>
							<span class="lib-thumb">
								@templ.Raw(thumbs[t.Name])
							</span>
							<span class="lib-name">
								@visIcon(t.Visibility)
								<strong>{ t.Title }</strong>
							</span>
							<span class="meta">{ boardRole(t) }</span>
						</a>
						<button class="icon dgr sec lib-rm" data-on:click={ "$_rm = {name: " + jsString(t.Name) + ", title: " + jsString(t.Title) + "}; document.getElementById('remove-confirm').showModal()" } aria-label={ "Remove " + t.Title + " from your boards" } title="Remove from your boards">
							@Icon("trash")
						</button>
					</li>
				}
			</ul>
		}
	</section>
}

// libraryBoards: your boards, the latest opened first; not the global board
// (it has its own way in) and not a book's whiteboard (its book stands for it).
func libraryBoards(tabs []db.Tab, books []db.Book) []db.Tab {
	inBook := map[string]bool{}
	for _, b := range books {
		inBook[b.Board] = true
	}
	var out []db.Tab
	for i := len(tabs) - 1; i >= 0; i-- {
		if t := tabs[i]; t.Name != db.GlobalName && !inBook[t.Name] {
			out = append(out, t)
		}
	}
	return out
}

// frontDrawer opens from the logo on the front pages.
templ frontDrawer() {
	<aside id="nav-drawer" class="drawer left nav-drawer" popover aria-label="Menu">
		@drawerHead()
		<nav class="nav-list" aria-label="Menu">
			@libraryLink()
			@newSection()
			@learnSection()
		</nav>
		<p class="fine"><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
	</aside>
}

// libraryLink: home is the library, everything of yours as it looks.
templ libraryLink() {
	<a href="/" class="lib-link">
		@Icon("home")
		Library
	</a>
}

// newSection: every way to start something, in one place.
templ newSection() {
	<section class="nav-sec" aria-label="New" data-init={ navSecInit("New") }>
		<button class="nav-sec-head" aria-expanded="true" data-on:click={ navSecToggle("New") }>
			<h3>New</h3>
			@Icon("chevron")
		</button>
		@newBoardRow()
		@newBookRow()
		<button class="demo-entry" data-on:click={ openWriter } title="Claude writes a lesson book with your key">
			@Icon("sparkles")
			<span>Write a lesson…</span>
			<span class="meta">a topic in, a lesson book out</span>
		</button>
		<div id="writer-status"></div>
	</section>
}

// The drawer's pieces, shared by the board page and the front pages.

templ drawerHead() {
	<header class="drawer-head">
		<a class="brand" href="/">
			@Mark()
			<span>draw</span>
		</a>
		<button class="icon" popovertarget="nav-drawer" popovertargetaction="hide" aria-label="Close menu">
			@Icon("x")
		</button>
	</header>
}

// newBoardRow: a new board, public or private, in one row.
templ newBoardRow() {
	<div class="new-row">
		<span class="label">
			@Icon("plus")
			New board
		</span>
		<div class="button-group">
			<button data-on:click={ newBoard(db.Public) } title="Anyone with the link can draw">
				@Icon("link")
				Public
			</button>
			<button data-on:click={ newBoard(db.Private) } title="Only you and the people you invite">
				@Icon("lock")
				Private
			</button>
		</div>
	</div>
}

// learnSection: the demos, each played on a new board.
templ learnSection() {
	<section class="nav-sec" aria-label="Learn" data-init={ navSecInit("Learn") }>
		<button class="nav-sec-head" aria-expanded="true" data-on:click={ navSecToggle("Learn") }>
			<h3>Learn <span class="tag">beta</span></h3>
			@Icon("chevron")
		</button>
		<button class="demo-entry" data-on:click="@post('/course/go')" title="Learning Go: a lesson book, a page at a time">
			@Icon("book")
			<span>Learning Go</span>
			<span class="meta">a lesson book: small pages, played as you open them</span>
		</button>
	</section>
}

// demoEntry starts a demo: a new board with a presenter on it.
templ demoEntry(kind, title, sub string) {
	<button class="demo-entry" data-on:click={ "@post('/demo/" + kind + "')" } title={ title + ": played on a new board" }>
		@Icon("play")
		<span>{ title }</span>
		<span class="meta">{ sub }</span>
	</button>
}

// removeDialog asks before a board leaves your list ($_rm names it).
templ removeDialog() {
	<dialog id="remove-confirm" class="modal content-1 confirm" closedby="any" aria-label="Remove from your boards">
		<h2>Remove from your boards?</h2>
		<p><strong data-text="$_rm.title"></strong> leaves your list. The board itself is kept: open its link again to bring it back.</p>
		<div class="row end">
			<button data-on:click="document.getElementById('remove-confirm').close()" autofocus>Cancel</button>
			<button class="dgr" data-on:click="@post('/tabs/close/' + $_rm.name); document.getElementById('remove-confirm').close()">
				@Icon("trash")
				Remove
			</button>
		</div>
	</dialog>
}

func googleURL(next string) string {
	if next == "" {
		return "/auth/google"
	}
	return "/auth/google?next=" + url.QueryEscape(next)
}

func devSignals(next string) string {
	return "{" + savedSignal + ", email: '', next: " + jsString(next) + "}"
}

func initial(u *db.User) string {
	f := u.First()
	if f == "" {
		return "?"
	}
	return string([]rune(f)[:1])
}

func boardRole(t db.Tab) string {
	switch {
	case t.Owned && t.Visibility == db.Private:
		return "private · yours"
	case t.Owned:
		return "public · yours"
	case t.Visibility == db.Private:
		return "private · shared with you"
	}
	return "public"
}
